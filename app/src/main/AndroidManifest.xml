<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required so Google Play Services can fetch Hanken Grotesk / Geist Mono
         via the Downloadable Fonts API at runtime (see ui/theme/Type.kt).
         No fonts are bundled in the APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the in-app "Check for Updates" flow (Settings > About) launch
         the system installer directly on a downloaded APK, instead of
         sending the person to a browser to download it manually. The
         person still has to tap "Install" on Android's own confirmation
         dialog — that's an OS-level control this permission doesn't
         bypass — but everything before that (checking, downloading,
         opening the installer) happens without leaving the app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Only meaningful on API < 29 (scoped storage made this obsolete from
         Android 10 onward, and the Photo Picker needs no permission at
         all). Requested by PermissionScreen only on those legacy
         versions, to improve the odds CommandGenerator can resolve a real
         on-disk path instead of falling back to the app cache. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Required on API 30+ (and enforced by targetSdk 34) so the app is
         allowed to detect whether Termux is installed. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.StatusHDLite"
        android:supportsRtl="true">

        <!-- Exposes cacheDir/update.apk to the system installer as a
             content:// URI (installers can't be handed a raw file:// path
             on modern Android). Backs the Check for Updates download flow
             in SettingsScreen.kt / UpdateInstaller.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StatusHDLite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
