<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: a subtle diagonal gradient in the brand
     crimson rather than a flat fill, for a bit of depth at launcher size.
     Gradients in vector drawables need API 24+; minSdk here is 26. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#D6004E"
                android:endColor="#8E0034" />
        </aapt:attr>
    </path>
</vector>
