<?xml version="1.0" encoding="utf-8"?>
<!-- Only the app's own cache dir is exposed — that's where
     UpdateInstaller.downloadApk() saves the downloaded update, and
     nothing else needs to be reachable through this provider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="." />
</paths>
